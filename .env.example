# =======================================================================
# AskATutorLive — environment variables
# Copy to `.env` (or set in Vercel) and fill in. See MIGRATION.md.
# =======================================================================

# ---- Database / Auth (Supabase) -- KEEP across migration ---------------
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=
SUPABASE_SERVICE_ROLE_KEY=    # server-only, never expose to client

# ---- AI provider adapter (src/lib/ai/provider.server.ts) ---------------
# AI_PROVIDER=lovable  (default)  -> uses LOVABLE_API_KEY + Lovable Gateway
# AI_PROVIDER=gemini              -> uses GEMINI_API_KEY directly
AI_PROVIDER=lovable
LOVABLE_API_KEY=              # auto-provisioned on Lovable; remove off-platform
GEMINI_API_KEY=               # set when AI_PROVIDER=gemini

# ---- Email provider adapter (src/lib/email/provider.server.ts) ---------
# EMAIL_PROVIDER=lovable (default) -> enqueues into Lovable Emails queue
# EMAIL_PROVIDER=resend            -> sends directly via Resend
EMAIL_PROVIDER=lovable
RESEND_API_KEY=               # set when EMAIL_PROVIDER=resend
RESEND_FROM="Ask A Tutor <notify@yourdomain.com>"

# ---- Public URLs --------------------------------------------------------
PUBLIC_BASE_URL=https://askatutor.lovable.app
VITE_PUBLIC_BASE_URL=https://askatutor.lovable.app

# ---- Payments (PayPal) --------------------------------------------------
# Configured in DB (payment_providers table). No env vars required.
