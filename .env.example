# =======================================================================
# AskATutorLive — environment variables
# Copy to `.env` (local) or set them in your host's dashboard.
# Nothing here is tied to a specific hosting provider.
# =======================================================================

# ---- Database / Auth (Supabase) ---------------------------------------
# Client-side (safe to expose, publishable key only)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
# Server-side
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=
SUPABASE_SERVICE_ROLE_KEY=        # server-only, never expose to the client

# ---- Public URLs -------------------------------------------------------
PUBLIC_BASE_URL=https://your-domain.com
VITE_PUBLIC_BASE_URL=https://your-domain.com

# ---- AI provider (src/lib/ai/provider.server.ts) -----------------------
# gemini (default) | groq | ollama
# Leave AI_PROVIDER empty to let Admin -> AI choose it at runtime.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ---- Email (src/lib/email/provider.server.ts) --------------------------
# resend (default) | smtp | none
EMAIL_PROVIDER=resend
RESEND_API_KEY=
# Optional hard override of the From header; otherwise built from the values below.
RESEND_FROM=
EMAIL_FROM_DOMAIN=your-domain.com
EMAIL_FROM_NAME=Ask A Tutor
# Only for EMAIL_PROVIDER=smtp (your own HTTP->SMTP relay)
SMTP_RELAY_URL=
SMTP_RELAY_TOKEN=

# ---- Server runtime ----------------------------------------------------
# Build target: node-server | vercel | cloudflare-module (default)
NITRO_PRESET=node-server
PORT=3000
HOST=0.0.0.0

# ---- Payments (PayPal) -------------------------------------------------
# Configured in the database (payment_providers table). No env vars required.
